{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:companion-rehab:roadmap:1.5.0",
  "title": "Companion Rehab agent implementation roadmap",
  "type": "object",
  "properties": {
    "$schema": {
      "const": "./roadmap.schema.json"
    },
    "roadmap_id": {
      "const": "companion-rehab"
    },
    "schema_version": {
      "const": "1.5.0"
    },
    "updated_at": {
      "type": "string",
      "format": "date"
    },
    "planning_status": {
      "enum": [
        "draft",
        "ready_for_implementation"
      ]
    },
    "implementation_status": {
      "enum": [
        "not_started",
        "in_progress",
        "complete"
      ]
    },
    "source_of_truth": {
      "type": "string",
      "minLength": 1
    },
    "source_brief": {
      "type": "string",
      "format": "uri"
    },
    "supporting_research": {
      "type": "string",
      "minLength": 1
    },
    "supersedes": {
      "type": "string",
      "minLength": 1
    },
    "user_priorities": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "constraints": {
      "type": "object",
      "properties": {
        "budget": {
          "type": "object",
          "properties": {
            "monthly_limit": {
              "const": 50
            },
            "target_ceiling": {
              "type": "number",
              "minimum": 0,
              "maximum": 50
            },
            "currency": {
              "enum": [
                null,
                "CAD",
                "USD"
              ]
            },
            "planning_currency": {
              "enum": [
                "CAD",
                "USD"
              ]
            },
            "currency_status": {
              "enum": [
                "unconfirmed",
                "confirmed"
              ]
            },
            "excluded": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            },
            "included": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            },
            "strategy": {
              "type": "string",
              "minLength": 1
            },
            "billing_monitor_status": {
              "enum": [
                "not_implemented",
                "implemented"
              ]
            }
          },
          "required": [
            "monthly_limit",
            "target_ceiling",
            "currency",
            "planning_currency",
            "currency_status",
            "excluded",
            "included",
            "strategy",
            "billing_monitor_status"
          ],
          "additionalProperties": false
        },
        "runtime": {
          "type": "object",
          "properties": {
            "application": {
              "type": "string",
              "minLength": 1
            },
            "worker": {
              "type": "string",
              "minLength": 1
            },
            "database": {
              "type": "string",
              "minLength": 1
            },
            "synthetic_database": {
              "type": "string",
              "minLength": 1
            },
            "ingress": {
              "type": "string",
              "minLength": 1
            },
            "availability": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "application",
            "worker",
            "database",
            "synthetic_database",
            "ingress",
            "availability"
          ],
          "additionalProperties": false
        },
        "data": {
          "type": "object",
          "properties": {
            "first_live_use": {
              "type": "string",
              "minLength": 1
            },
            "care_rules": {
              "type": "string",
              "minLength": 1
            },
            "public_repository": {
              "type": "string",
              "minLength": 1
            },
            "private_evidence": {
              "type": "string",
              "minLength": 1
            },
            "retention": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "first_live_use",
            "care_rules",
            "public_repository",
            "private_evidence",
            "retention"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "budget",
        "runtime",
        "data"
      ],
      "additionalProperties": false
    },
    "execution_policy": {
      "type": "object",
      "properties": {
        "selection": {
          "type": "string",
          "minLength": 1
        },
        "unit_of_delivery": {
          "type": "string",
          "minLength": 1
        },
        "setup": {
          "type": "string",
          "minLength": 1
        },
        "dashboard_boundary": {
          "type": "string",
          "minLength": 1
        },
        "live_test_requirement": {
          "type": "string",
          "minLength": 1
        },
        "done_rule": {
          "type": "string",
          "minLength": 1
        },
        "result_policy": {
          "type": "string",
          "minLength": 1
        },
        "revision_policy": {
          "type": "string",
          "minLength": 1
        },
        "input_policy": {
          "type": "string",
          "minLength": 1
        },
        "cost_policy": {
          "type": "string",
          "minLength": 1
        },
        "scope_policy": {
          "type": "string",
          "minLength": 1
        },
        "authorization": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "selection",
        "unit_of_delivery",
        "setup",
        "dashboard_boundary",
        "live_test_requirement",
        "done_rule",
        "result_policy",
        "revision_policy",
        "input_policy",
        "cost_policy",
        "scope_policy",
        "authorization"
      ],
      "additionalProperties": false
    },
    "status_values": {
      "type": "array",
      "const": [
        "planned",
        "in_progress",
        "awaiting_live_test",
        "blocked",
        "done"
      ]
    },
    "shared_requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^R-[A-Z]+$"
          },
          "introduced_in": {
            "$ref": "#/$defs/sliceId"
          },
          "requirement": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "introduced_in",
          "requirement"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "operator_inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^I-[A-Z]+(?:-[A-Z]+)*$"
          },
          "status": {
            "enum": [
              "unresolved",
              "defaulted",
              "resolved"
            ]
          },
          "default": {
            "type": [
              "string",
              "null"
            ]
          },
          "needed_for": {
            "type": "string",
            "minLength": 1
          },
          "question": {
            "type": "string",
            "minLength": 1
          },
          "resolution_ref": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "status",
          "default",
          "needed_for",
          "question",
          "resolution_ref"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "service_defaults": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "choice": {
            "type": "string",
            "minLength": 1
          },
          "plan": {
            "type": "string",
            "minLength": 1
          },
          "introduced_in": {
            "$ref": "#/$defs/sliceId"
          },
          "incremental_subscription": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          }
        },
        "required": [
          "id",
          "choice",
          "plan",
          "introduced_in",
          "incremental_subscription"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "slices": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/slice"
      },
      "minItems": 1
    },
    "release_gates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^G-[A-Z-]+$"
          },
          "required_slices": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/sliceId"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "requirement": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "required_slices",
          "requirement"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "deferred": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^D-[A-Z-]+$"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "reason"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "human_action_policy": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "agent_responsibility": {
          "type": "string",
          "minLength": 1
        },
        "carry_forward": {
          "type": "string",
          "minLength": 1
        },
        "timing": {
          "type": "string",
          "minLength": 1
        },
        "conditional_actions": {
          "type": "string",
          "minLength": 1
        },
        "completion": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        },
        "roles": {
          "type": "string",
          "minLength": 1
        },
        "deferred": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "source",
        "agent_responsibility",
        "carry_forward",
        "timing",
        "conditional_actions",
        "completion",
        "evidence",
        "roles",
        "deferred"
      ],
      "additionalProperties": false
    },
    "delivery_focus": {
      "type": "object",
      "properties": {
        "slice_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sliceId"
          },
          "minItems": 4,
          "uniqueItems": true,
          "maxItems": 4
        },
        "assistant_name": {
          "const": "Nancy"
        },
        "daily_checkin_local_time": {
          "type": "string",
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
        },
        "entry_mode": {
          "enum": [
            "user_initiated"
          ]
        },
        "timezone_source": {
          "const": "participant_profile"
        },
        "timezone_input_id": {
          "type": "string",
          "minLength": 1
        },
        "outcome": {
          "type": "string",
          "minLength": 1
        },
        "completion_gate_id": {
          "type": "string",
          "minLength": 1
        },
        "scope_boundary": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "slice_ids",
        "assistant_name",
        "daily_checkin_local_time",
        "entry_mode",
        "timezone_source",
        "timezone_input_id",
        "outcome",
        "completion_gate_id",
        "scope_boundary"
      ],
      "additionalProperties": false
    },
    "reuse_plan": {
      "type": "object",
      "properties": {
        "assessment_ref": {
          "type": "string",
          "minLength": 1
        },
        "source_repository": {
          "type": "string",
          "minLength": 1
        },
        "source_revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "verification": {
          "type": "string",
          "minLength": 1
        },
        "architecture": {
          "type": "string",
          "minLength": 1
        },
        "excluded": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "components": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^RU-[A-Z-]+$"
              },
              "decision": {
                "enum": [
                  "extract_adapt",
                  "port_pattern",
                  "reference_tests"
                ]
              },
              "source_paths": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1,
                "uniqueItems": true
              },
              "application": {
                "type": "string",
                "minLength": 1
              },
              "limits": {
                "type": "string",
                "minLength": 1
              },
              "source_revision": {
                "type": "string",
                "pattern": "^[a-f0-9]{40}$"
              }
            },
            "required": [
              "id",
              "decision",
              "source_paths",
              "application",
              "limits",
              "source_revision"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "assessment_ref",
        "source_repository",
        "source_revision",
        "verification",
        "architecture",
        "excluded",
        "components"
      ],
      "additionalProperties": false
    },
    "product_contract": {
      "type": "object",
      "properties": {
        "decision_ref": {
          "type": "string",
          "minLength": 1
        },
        "administrator_owner": {
          "type": "string",
          "minLength": 1
        },
        "technical_lead_owner": {
          "type": "string",
          "minLength": 1
        },
        "roles": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "enum": [
                  "administrator",
                  "client",
                  "family_friend",
                  "clinician"
                ]
              },
              "home": {
                "type": "string",
                "minLength": 1
              },
              "home_introduced_in": {
                "$ref": "#/$defs/sliceId"
              },
              "primary_interaction": {
                "enum": [
                  "voice",
                  "ui"
                ]
              },
              "ui_required": {
                "const": true
              },
              "capabilities": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              }
            },
            "required": [
              "id",
              "home",
              "home_introduced_in",
              "primary_interaction",
              "ui_required",
              "capabilities"
            ],
            "additionalProperties": false
          },
          "minItems": 4,
          "maxItems": 4,
          "allOf": [
            {
              "contains": {
                "type": "object",
                "properties": {
                  "id": {
                    "const": "administrator"
                  }
                },
                "required": [
                  "id"
                ]
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "type": "object",
                "properties": {
                  "id": {
                    "const": "client"
                  }
                },
                "required": [
                  "id"
                ]
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "type": "object",
                "properties": {
                  "id": {
                    "const": "family_friend"
                  }
                },
                "required": [
                  "id"
                ]
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "type": "object",
                "properties": {
                  "id": {
                    "const": "clinician"
                  }
                },
                "required": [
                  "id"
                ]
              },
              "minContains": 1,
              "maxContains": 1
            }
          ]
        },
        "client_navigation": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "enum": [
                  "tasks",
                  "meals",
                  "groceries",
                  "achievements"
                ]
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "introduced_in": {
                "$ref": "#/$defs/sliceId"
              }
            },
            "required": [
              "id",
              "label",
              "introduced_in"
            ],
            "additionalProperties": false
          },
          "minItems": 4,
          "maxItems": 4,
          "allOf": [
            {
              "contains": {
                "type": "object",
                "properties": {
                  "id": {
                    "const": "tasks"
                  }
                },
                "required": [
                  "id"
                ]
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "type": "object",
                "properties": {
                  "id": {
                    "const": "meals"
                  }
                },
                "required": [
                  "id"
                ]
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "type": "object",
                "properties": {
                  "id": {
                    "const": "groceries"
                  }
                },
                "required": [
                  "id"
                ]
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "type": "object",
                "properties": {
                  "id": {
                    "const": "achievements"
                  }
                },
                "required": [
                  "id"
                ]
              },
              "minContains": 1,
              "maxContains": 1
            }
          ]
        },
        "navigation_policy": {
          "type": "string",
          "minLength": 1
        },
        "task_model": {
          "type": "object",
          "properties": {
            "user_facing_fields": {
              "const": [
                "what",
                "urgency",
                "scheduled_date_time"
              ]
            },
            "urgency_values": {
              "const": [
                "high",
                "medium",
                "low"
              ]
            },
            "schedule_policy": {
              "type": "string",
              "minLength": 1
            },
            "meals_are_tasks": {
              "const": true
            },
            "meal_policy": {
              "type": "string",
              "minLength": 1
            },
            "internal_metadata": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "user_facing_fields",
            "urgency_values",
            "schedule_policy",
            "meals_are_tasks",
            "meal_policy",
            "internal_metadata"
          ],
          "additionalProperties": false
        },
        "family_notification_events": {
          "const": [
            "task_completed",
            "task_rescheduled"
          ]
        },
        "family_notification_policy": {
          "type": "string",
          "minLength": 1
        },
        "clinical_archetypes": {
          "const": [
            "Diabetes",
            "Neurorehab",
            "Psychologist / Psychiatrist",
            "Family doctor",
            "OT / PSW / DSW"
          ]
        },
        "clinical_dashboard_policy": {
          "type": "string",
          "minLength": 1
        },
        "data_hosting": {
          "type": "object",
          "properties": {
            "initial": {
              "type": "string",
              "minLength": 1
            },
            "database_target": {
              "type": "string",
              "minLength": 1
            },
            "migration_targets": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            },
            "migration_policy": {
              "type": "string",
              "minLength": 1
            },
            "cloud_processing": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "initial",
            "database_target",
            "migration_targets",
            "migration_policy",
            "cloud_processing"
          ],
          "additionalProperties": false
        },
        "ai_backend": {
          "type": "object",
          "properties": {
            "requested_family": {
              "const": "GPT Sol"
            },
            "reasoning_effort": {
              "const": "high"
            },
            "api_model_id": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            },
            "model_input_id": {
              "const": "I-MODEL"
            },
            "api": {
              "type": "string",
              "minLength": 1
            },
            "speech_policy": {
              "type": "string",
              "minLength": 1
            },
            "source_refs": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "uri"
              },
              "minItems": 1
            },
            "reasoning_route": {
              "type": "object",
              "properties": {
                "decision_ref": {
                  "type": "string",
                  "minLength": 1
                },
                "preferred": {
                  "const": "chatgpt_plan"
                },
                "adapter_preference": {
                  "const": "minimal_local_codex_app_server_or_supported_responses"
                },
                "qualification_status": {
                  "enum": [
                    "pending",
                    "in_progress",
                    "qualified",
                    "failed"
                  ]
                },
                "active_route": {
                  "enum": [
                    null,
                    "chatgpt_plan",
                    "api_key"
                  ]
                },
                "qualification_evidence_ref": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "minLength": 1
                },
                "api_key_fallback": {
                  "const": "explicit_owner_decision_after_qualification_and_cost_review"
                },
                "account_policy": {
                  "type": "string",
                  "minLength": 1
                },
                "qualification_order": {
                  "const": [
                    "account_and_deployment_eligibility",
                    "sol_high_reasoning",
                    "speech_input_output",
                    "authorized_care_tools",
                    "device_and_live_acceptance"
                  ]
                }
              },
              "required": [
                "decision_ref",
                "preferred",
                "adapter_preference",
                "qualification_status",
                "active_route",
                "qualification_evidence_ref",
                "api_key_fallback",
                "account_policy",
                "qualification_order"
              ],
              "additionalProperties": false,
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "qualification_status": {
                        "const": "qualified"
                      }
                    },
                    "required": [
                      "qualification_status"
                    ]
                  },
                  "then": {
                    "properties": {
                      "active_route": {
                        "enum": [
                          "chatgpt_plan",
                          "api_key"
                        ]
                      },
                      "qualification_evidence_ref": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  },
                  "else": {
                    "properties": {
                      "active_route": {
                        "type": "null"
                      },
                      "qualification_evidence_ref": {
