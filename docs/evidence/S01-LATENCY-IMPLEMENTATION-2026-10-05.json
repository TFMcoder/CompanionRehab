  "slice_id": "S01",
  "status": "deployed_latency_improvements_awaiting_actual_device_acceptance",
  "recorded_at": "2026-10-05T22:31:56.872Z",
  "implementation_revision": "sha256:22b64add541a3102503148242c113f05c0588eddccd7f0cea6c95bd80cbe6249",
  "source_base_commit": "c97470a1b42bd3bb76994b3894e3bd457a4d3dab",
  "owner_direction": "Implement the measured latency fixes; retain owner-selected Heart, GPT-6 Sol high, local care storage and the existing approved HTTPS pilot.",
  "changes": [
    "Recognize anchored natural requests to open one authorized view without inference. Negations, compound requests and substantive questions remain on the reasoning path. A single validated model navigation call uses the same fixed acknowledgement without a second model call.",
    "Prime four short Heart navigation acknowledgements before the server accepts requests, using a bounded memory cache. Retain the existing bounded short-greeting cache; arbitrary care replies are not globally cached.",
    "Use an isolated pinned NVIDIA runtime for explicit local CUDA small.en float16 transcription. CPU int8 remains the default for other configurations. Wrong runtime/device fails closed with voice unavailable, rather than silently falling back.",
    "Keep the first spoken sentence separate; ask for concise replies. Tentatively prepare the first complete speech part while assistant text streams, releasing it only after completed exact-model validation, matching final text and renewed care authorization. Interruption, logout, tool narration, changed output and eviction discard it.",
    "Retain Kokoro Heart CPU fp32 and normal speed, the configured 900 ms silence threshold, GPT-6 Sol high, care commands, accepted-plan confirmation and the public pilot URL."
  ],
  "method": {
    "data": "Generated synthetic Heart WAVs and explicitly synthetic owner practice records. No human microphone capture or private transcript is included here.",
    "time": "Monotonic service durations. Estimated end-of-speech values add the configured 900 ms silence threshold to measured request/first-WAV durations; physical phone endpointing, decoding and playback are not measured.",
    "comparison": "Same fixed synthetic input phrases as the prior diagnosis. Model wording and remote response timing vary; this is a small sample, not p95 or a controlled provider benchmark.",
    "authorization": "Instrumented comparisons deny durable care writes and confirmed the saved plan unchanged. Separate live acceptance regression intentionally accepts a disposable synthetic practice plan."
  },
