{
  "name": "companion-rehab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "build": "vite build --configLoader runner",
    "start": "tsx src/server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --configLoader runner",
    "check": "npm run typecheck && npm test && npm run build",
    "readiness": "tsx scripts/readiness.ts",
    "readiness:openai": "tsx scripts/check-openai.ts",
    "connect:chatgpt": "tsx scripts/chatgpt-plan.ts",
    "preview:device": "tsx scripts/device-preview.ts",
    "backup": "tsx scripts/backup.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.0.2",
    "fastify": "5.12.5",
    "pg": "8.16.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "ws": "8.22.0",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.14",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@types/node": "24.10.0",
    "@types/pg": "8.15.5",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/ws": "8.18.1",
    "jsdom": "26.1.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  }
}
