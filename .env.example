# Copy to .env.local. Never commit credentials or participant data.
PUBLIC_ORIGIN=http://localhost:8787
PORT=8787
# Initial My Day data is local PostgreSQL. Keep runtime credentials under .local.
DATABASE_URL=
NANCY_VOICE_TRANSPORT=local
# Explicit owner care-account UUID linked to the app-specific ChatGPT OAuth account.
# A different participant needs their own eligibility/auth qualification.
NANCY_PLAN_USER_ID=
NANCY_SYNTHETIC=1
# Historical Supabase/Realtime configuration; never a silent local fallback.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_KEY=
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-mini
VOICE_SESSION_MINUTES=10
VOICE_DAILY_MINUTES=20
# Separate administrative backup/restore configuration; never used by the application.
# BACKUP_DATABASE_URL=
# BACKUP_KEY= (a different, securely stored 32-byte base64 key)
# RESTORE_DATABASE_URL= (isolated empty target only)
# RESTORE_TARGET=isolated-disposable
